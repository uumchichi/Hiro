# ── AI (Claude) ── 없으면 규칙 기반 분석/매칭으로 동작합니다.
ANTHROPIC_API_KEY=
# 기본값: claude-opus-5-5
# HIRO_MODEL=claude-opus-5-5

# ── 음성 (LiveKit Cloud: https://cloud.livekit.io) ── 없으면 음성 없이 화면 흐름만 진행됩니다.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ── 운영 ──
# 설정하면 /admin 화면과 운영 API에 이 키가 필요합니다. 배포 시 꼭 설정하세요.
HIRO_ADMIN_KEY=
# 그룹 인원, 라운드 길이(초), 라운드 사이 쉬는 시간(초)
HIRO_GROUP_MIN=4
HIRO_GROUP_MAX=6
HIRO_ROUND_SECONDS=300
HIRO_BREAK_SECONDS=20
# 세션: 몇 분 간격으로 열지, 게시판에 몇 개를 늘 열어 둘지, 시작 몇 분 전부터 대기실 입장
HIRO_SLOT_INTERVAL_MINUTES=60
HIRO_UPCOMING_SLOTS=3
HIRO_CHECKIN_MINUTES=10
# AI 초대장: 수락 시간(초), 한 번에 초대하는 최대 인원
HIRO_INVITE_SECONDS=60
HIRO_INVITE_SIZE=8
# 예약 시간 계산 기준 (배포 시)
TZ=Asia/Seoul
